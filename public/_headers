/london/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/london/data/*.pbf
  Content-Type: application/x-protobuf

/london/data/*.json
  Cache-Control: public, max-age=300

/tfl/data/*
  Cache-Control: public, max-age=3600
/tfl/*.js
  Cache-Control: no-cache

/tfl/*.css
  Cache-Control: no-cache
